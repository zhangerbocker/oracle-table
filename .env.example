# Copy to .env.local (git-ignored) for local runs. On Vercel, set these in
# Project Settings -> Environment Variables. Each oracle has its own Parley key;
# an oracle without one still works, using its built-in text where it has some.

# The Three Coins Oracle (I Ching), /oracle/
ORACLE_PARLEY_API_KEY=
# Optional, default claude-sonnet-4-6
ORACLE_MODEL=

# The Sorting Hat, /sorting-hat/
SORTING_HAT_PARLEY_API_KEY=
# Optional, default claude-sonnet-5-5
SORTING_HAT_MODEL=

# The Four Pillars (saju), /korean-saju/
SAJU_PARLEY_API_KEY=
# Optional, default claude-sonnet-5
READING_MODEL=

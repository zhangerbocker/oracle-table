# Copy to .env.local and fill in. NEVER commit the real key.
#
# Locally:  the dev server reads these from your shell environment.
# On Vercel: set them in Project Settings -> Environment Variables.
#            Do not put them in any file that ships to the browser.

# MIT's Parley gateway speaks the Anthropic Messages API.
ANTHROPIC_BASE_URL=https://parley.api.mit.edu
ANTHROPIC_API_KEY=sk-parley-v1-replace-me

# Optional. Defaults to claude-sonnet-5.
# Use claude-haiku-4-5-20251001 if readings need to be faster and cheaper.
READING_MODEL=claude-sonnet-5

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/oracle.js": { "includeFiles": "oracle/**" },
    "api/prophecy.js": { "maxDuration": 30 },
    "api/reading.js": { "maxDuration": 60 }
  },
  "routes": [
    { "src": "^/dev\\.js$", "status": 404 },
    { "src": "^/(test|lib|korean-saju/test|korean-saju/prompts)(/.*)?$", "status": 404 },
    { "src": "^/package(-lock)?\\.json$", "status": 404 },
    { "src": "^/vercel\\.json$", "status": 404 },
    { "src": "^/\\.(gitignore|vercelignore)$", "status": 404 },
    { "src": "^/\\.env.*$", "status": 404 }
  ]
}
